# ============================================================================
# WalnutIQ: Tree Care & AI Count — Environment Variables (.env.example)
# Copy this file to `.env.local` and fill in your Convex & Clerk keys.
# The app automatically runs in Offline-First Orchard Mode if keys are omitted.
# ============================================================================

# 1. Convex Real-Time Database URL (generated by `npx convex dev`)
EXPO_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud

# 2. Clerk Publishable Key (from Clerk Dashboard -> API Keys)
# Supports Google OAuth 1-Tap Sign-In + Email/Password login
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# 3. Clerk JWT Issuer Domain (used by `convex/auth.config.ts`)
CLERK_JWT_ISSUER_DOMAIN=https://your-issuer.clerk.accounts.dev

# 4. Optional: Tuya Smart Orchard Sensor Cloud Plugin Credentials
EXPO_PUBLIC_TUYA_CLIENT_ID=
EXPO_PUBLIC_TUYA_REGION=eu

