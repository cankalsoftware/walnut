# 1. Shared Convex Real-Time Database URL (same as EXPO_PUBLIC_CONVEX_URL)
VITE_CONVEX_URL=https://your-project-name.convex.cloud

# 2. Shared Clerk Publishable Key (same as EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# 3. Python Background ML Worker URL (`python backend/server.py`)
VITE_ML_WORKER_URL=http://127.0.0.1:8000

